APP_NAME=ASM Asset Discovery Service
APP_VERSION=1.0.0
APP_LOG_LEVEL=INFO
APP_PORT=8000
POSTGRES_DB=asm_discovery
POSTGRES_USER=asm_discovery
POSTGRES_PASSWORD=replace-with-a-unique-local-database-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://asm_discovery:replace-with-a-unique-local-database-password@localhost:5432/asm_discovery
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
DNS_LOOKUP_TIMEOUT_SECONDS=3
SCAN_MAX_RUNTIME_SECONDS=900
